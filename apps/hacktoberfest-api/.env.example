# Hacktoberfest weekend demo API — copy to .env (never commit real keys)
# All secrets stay server-side / Render env only.

# Postgres (local or Render External URL for laptop; Internal URL on Render web service)
DATABASE_URL=postgres://user:password@localhost:5432/casescriptai_demo

# STT — Groq Whisper (open weights via hosted API)
GROQ_API_KEY=

# LLM — Google AI Studio / Gemma (open weights via hosted API)
GOOGLE_AI_API_KEY=

# Public base URL of this API (local or Render). Used for PDF download links later.
PUBLIC_BASE_URL=http://localhost:3001

# HTTP listen port (Render sets PORT automatically in production)
PORT=3001

# Optional: set to "1" to allow live provider smoke tests (never in CI by default)
LIVE_PROVIDER_SMOKE=0
