{
  "name": "CaseScriptAI",
  "private": true,
  "version": "0.0.1",
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "yarn workspace casescriptai run postinstall",
    "hacktoberfest:dev": "yarn workspace hacktoberfest-api dev",
    "hacktoberfest:test": "yarn workspace hacktoberfest-api test",
    "hacktoberfest:typecheck": "yarn workspace hacktoberfest-api typecheck",
    "hacktoberfest:migrate": "yarn workspace hacktoberfest-api migrate",
    "hacktoberfest:check": "yarn hacktoberfest:typecheck && yarn hacktoberfest:test"
  }
}
